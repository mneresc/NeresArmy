{
  "name": "neresarmy",
  "private": true,
  "type": "module",
  "workspaces": [
    "skills/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "install:skill": "node scripts/install-skill.mjs",
    "install:skill:all": "node scripts/install-skill.mjs --all --target all",
    "test": "node --test scripts/tests/*.test.mjs && npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:skills": "node scripts/validate-skills.mjs"
  }
}
