{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neresarmy.dev/schemas/visual-evidence.schema.json",
  "title": "VisualEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceId", "sourcePath", "classification", "confidence", "regions", "status"],
  "properties": {
    "sourceId": { "type": "string" },
    "sourcePath": { "type": "string" },
    "classification": {
      "enum": ["text", "table", "formula", "diagram", "mixed", "decorative", "unknown"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "regions": { "type": "array", "items": { "type": "object" } },
    "status": {
      "enum": ["supported", "ambiguous", "conflicting", "missing", "illegible"]
    }
  }
}
