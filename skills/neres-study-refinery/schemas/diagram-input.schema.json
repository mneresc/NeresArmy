{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neresarmy.dev/schemas/diagram-input.schema.json",
  "title": "DiagramInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "nodes", "edges", "groups", "score"],
  "properties": {
    "id": { "type": "string" },
    "type": { "enum": ["workflow", "sequence", "lifecycle", "dataflow", "architecture"] },
    "nodes": { "type": "array", "items": { "type": "object" } },
    "edges": { "type": "array", "items": { "type": "object" } },
    "groups": { "type": "array", "items": { "type": "object" } },
    "score": { "type": "integer" }
  }
}
