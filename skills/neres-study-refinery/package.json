{
  "name": "@neresarmy/neres-study-refinery",
  "version": "0.1.0",
  "private": true,
  "description": "Source-bounded didactic compiler for authorized Obsidian study notes.",
  "type": "module",
  "bin": {
    "neres-study-refinery": "dist/neres-study-refinery.mjs"
  },
  "files": [
    "config",
    "dist",
    "prompts",
    "schemas",
    "templates",
    "README.md",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-bundle.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0"
  }
}
