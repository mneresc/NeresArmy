{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mneresc/NeresArmy/skills/ob-study-visual-mapper/assets/schemas/visual-map.schema.json",
  "title": "Obsidian Study Visual Map IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "language",
    "intent",
    "sources",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": "visual-map/v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "intent": {
      "enum": [
        "concept-map",
        "classification",
        "process",
        "lifecycle",
        "comparison",
        "timeline",
        "competency",
        "exception-map",
        "formula-dependency",
        "architecture",
        "sequence",
        "data-flow"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceReference"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "layout": {
      "type": "object",
      "default": {}
    },
    "recall": {
      "type": "object",
      "default": {}
    },
    "archify": {
      "type": "object",
      "default": {}
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "subpath": {
          "type": "string",
          "pattern": "^#"
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticKey",
        "label",
        "kind",
        "importance",
        "sourceReferences",
        "recallPriority"
      ],
      "properties": {
        "semanticKey": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        },
        "sourceReferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "groupId": {
          "type": "string"
        },
        "layoutHints": {
          "type": "object"
        },
        "recallPriority": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticKey",
        "from",
        "to",
        "relationType",
        "displayLabel",
        "direction",
        "sourceReferences",
        "confidence",
        "recallPriority"
      ],
      "properties": {
        "semanticKey": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "relationType": {
          "type": "string",
          "minLength": 1
        },
        "displayLabel": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "forward",
            "reverse",
            "bidirectional"
          ]
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceReferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "confidence": {
          "enum": [
            "explicit",
            "supported",
            "ambiguous",
            "unresolved"
          ]
        },
        "recallPriority": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
